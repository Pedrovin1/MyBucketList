; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MyBucketList"
run/main_scene="res://Scenes/Telas/MainScreen/MainScreen.tscn"
config/features=PackedStringArray("4.2", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputManager="*res://Scripts/InputManager.cs"

[display]

window/size/viewport_width=300
window/size/viewport_height=200
window/size/resizable=false
window/size/borderless=true
window/size/window_width_override=300
window/size/window_height_override=200

[dotnet]

project/assembly_name="MyBucketList"

